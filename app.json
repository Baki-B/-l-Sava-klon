{
  "expo": {
    "name": "İl Savaşları",
    "slug": "il-savasi",
    "version": "1.0.0",
    "orientation": "landscape",
    "androidStatusBar": { "hidden": true, "translucent": true },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#1B2A38",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2A38"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bayirbaki.ilsavaslari",
      "buildNumber": "1",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.bayirbaki.ilsavaslari",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#152230",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font", "expo-screen-orientation", "./eklentiler/oyun-kategorisi.js"]
  }
}
